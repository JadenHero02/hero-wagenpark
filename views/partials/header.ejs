<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#073889">
  <title><%= title %> · Hero Wagenpark</title>
  <link rel="icon" type="image/svg+xml" href="/img/Hero_logo_blauw.svg">
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0&display=block">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <script>(function () { try { var t = localStorage.getItem("wp_thema") || "systeem"; var d = t === "donker" || (t === "systeem" && window.matchMedia("(prefers-color-scheme: dark)").matches); document.documentElement.setAttribute("data-thema", d ? "donker" : "licht"); } catch (e) {} })();</script>
</head>
<body>
<%
  const p = currentPath || "";
  const user = currentUser || null;
  const menu = [
    { href: "/", icon: "grid_view", label: "Dashboard", min: "directie" },
    { href: "/voertuigen", icon: "directions_car", label: "Wagenpark", min: "directie", badge: badges.voertuigen },
    { href: "/bestuurders", icon: "group", label: "Bestuurders", min: "directie" },
    { href: "/wachtlijst", icon: "hourglass_top", label: "Wachtlijst", min: "directie", badge: badges.wachtlijst },
    { href: "/uitleen", icon: "key", label: "Uitleen", min: "directie", badge: badges.uitleen },
    { href: "/taken", icon: "task_alt", label: "Taken", min: "directie", badge: badges.taken, hot: true },
    { href: "/incidenten", icon: "car_crash", label: "Incidenten", min: "directie", badge: badges.incidenten },
    { href: "/boetes", icon: "receipt_long", label: "Boetes", min: "directie", badge: badges.boetes },
    { href: "/contacten", icon: "contacts", label: "Contacten", min: "directie" },
    { href: "/archief", icon: "inventory_2", label: "Archief", min: "directie" },
    { href: "/processen", icon: "checklist", label: "Processen", min: "directie" },
    { href: "/export", icon: "download", label: "Export", min: "directie" },
    { href: "/instellingen/rollen", icon: "manage_accounts", label: "Rollen", min: "admin" },
    { href: "/instellingen", icon: "settings", label: "Instellingen", min: "admin" },
  ];
  // Actief: exact of een subpagina, tenzij een andere menuregel specifieker is (/instellingen/rollen onder /instellingen)
  const isActive = (prefix) => (prefix === "/" ? p === "/" : (p === prefix || p.startsWith(prefix + "/")) && !menu.some((m) => m.href !== prefix && m.href.startsWith(prefix + "/") && p.startsWith(m.href))) ? "on" : "";
%>
<div class="shell">
  <header class="topbar">
    <a href="/" class="brand"><img src="/img/Hero_logo_wit.svg" alt="Hero" width="46" height="39"><span class="brand-app"><span class="msr">directions_car</span>Wagenpark</span></a>
    <% if (can("directie")) { %><form class="topsearch" method="GET" action="/voertuigen" role="search">
      <span class="msr">search</span>
      <input type="search" name="q" id="topzoek" placeholder="Zoeken op kenteken, bestuurder, merk..." aria-label="Zoeken" autocomplete="off">
      <div class="zoek-lijst" id="zoek-lijst" hidden></div>
    </form><% } %>
    <div class="topbar-right">
      <% if (user) { %>
        <details class="usermenu">
          <summary><span class="avatar"><%= h.initials(user.name) %></span></summary>
          <div class="usermenu-list">
            <div class="usermenu-head"><strong><%= user.name %></strong><span class="muted small"><%= user.email %> · <%= h.label("role", user.role) %></span></div>
            <a href="/mijn-auto"><span class="msr">directions_car</span>Mijn auto</a>
            <form method="POST" action="/logout"><button type="submit"><span class="msr">logout</span>Uitloggen</button></form>
            <div class="thema-keuze" title="Weergave"><button type="button" data-thema-knop="licht"><span class="msr">light_mode</span>Licht</button><button type="button" data-thema-knop="donker"><span class="msr">dark_mode</span>Donker</button><button type="button" data-thema-knop="systeem"><span class="msr">contrast</span>Systeem</button></div>
          </div>
        </details>
      <% } %>
    </div>
  </header>
  <div class="body">
    <nav class="sidenav">
      <% menu.forEach((m) => { if (!can(m.min)) return; %>
        <a href="<%= m.href %>" class="side-link <%= isActive(m.href) %>">
          <span class="msr"><%= m.icon %></span><span class="label"><%= m.label %></span>
          <% if (m.badge) { %><span class="side-badge <%= m.hot ? 'hot' : '' %>"><%= m.badge %></span><% } %>
        </a>
      <% }) %>
      <% if (user && (currentBestuurder || !can("directie"))) { %>
        <% if (can("directie")) { %><div class="sidenav-sep"></div><% } %>
        <a href="/mijn-auto" class="side-link <%= isActive('/mijn-auto') %>"><span class="msr">person_pin_circle</span><span class="label">Mijn auto</span></a>
      <% } %>
      <% if (user) { %>
      <div class="sidenav-foot">
        <div class="versie-bubble" id="versie-bubble" hidden>Klik op het versienummer om bugs en wensen door te geven.</div>
        <a href="/versie" class="versie-link <%= isActive('/versie') %>" id="versie-link">Versie <%= versie.huidige %> · vernieuwt vanzelf bij rust</a>
      </div>
      <% } %>
    </nav>
    <main class="main">
      <% if (typeof flash !== "undefined" && flash) { %><div class="flash <%= flashKind %>"><span class="msr"><%= flashKind === "error" ? "error" : "check_circle" %></span><%= flash %></div><% } %>
