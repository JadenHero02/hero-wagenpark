    </main>
  </div>
</div>
<div class="versie-nieuw" id="versie-nieuw" hidden><span class="msr">system_update</span>Er staat een nieuwe versie klaar.<button type="button" onclick="location.reload()">Vernieuwen</button></div>
<script>
(function () {
  // Installeerbare versie: service worker voor het beginscherm, en in Mijn auto de hint (alleen telefoon, alleen in de browser, na "Later" een week stil)
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(function () {});
  var kaart = document.getElementById("install-kaart");
  if (!kaart) return;
  var standalone = window.matchMedia("(display-mode: standalone)").matches || window.navigator.standalone === true;
  var telefoon = window.matchMedia("(max-width: 860px)").matches && ("ontouchstart" in window || navigator.maxTouchPoints > 0);
  var later = 0; try { later = Number(localStorage.getItem("wp_install_later") || 0); } catch (e) {}
  if (standalone || !telefoon || Date.now() - later < 7 * 24 * 3600 * 1000) return;
  var ios = /iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  kaart.querySelectorAll("[data-platform]").forEach(function (el) { el.hidden = el.getAttribute("data-platform") !== (ios ? "ios" : "android"); });
  kaart.hidden = false;
  var prompt = null, knop = document.getElementById("install-knop");
  window.addEventListener("beforeinstallprompt", function (e) { e.preventDefault(); prompt = e; knop.hidden = false; });
  knop.addEventListener("click", function () { if (!prompt) return; prompt.prompt(); prompt.userChoice.then(function () { kaart.hidden = true; }); });
  document.getElementById("install-later").addEventListener("click", function () { kaart.hidden = true; try { localStorage.setItem("wp_install_later", String(Date.now())); } catch (e) {} });
  window.addEventListener("appinstalled", function () { kaart.hidden = true; });
})();
(function () {
  // Lijsten filteren terwijl je typt: het zoekveld met data-live-filter verbergt regels die de getypte letters niet bevatten.
  // Kentekens matchen ook zonder streepjes. Enter of de knop Zoeken doet nog steeds de volledige zoekopdracht op de server.
  var veld = document.querySelector("[data-live-filter]");
  if (!veld) return;
  var teller = document.querySelector("[data-live-count]");
  var norm = function (s) { return String(s || "").toLowerCase().replace(/[^a-z0-9à-ÿ]/g, ""); };
  var rijen = null;
  function filter() {
    if (!rijen) rijen = Array.prototype.slice.call(document.querySelectorAll(veld.getAttribute("data-live-filter"))).map(function (tr) { return { tr: tr, t: tr.textContent.toLowerCase(), n: norm(tr.textContent) }; });
    var q = veld.value.trim().toLowerCase(), qn = norm(q), aantal = 0;
    rijen.forEach(function (r) { var ok = !q || r.t.indexOf(q) >= 0 || (qn && r.n.indexOf(qn) >= 0); r.tr.hidden = !ok; if (ok) aantal++; });
    if (teller) teller.textContent = q ? (aantal ? aantal + " van " + rijen.length : "niets gevonden op deze pagina, druk op Enter om overal te zoeken") : "";
  }
  veld.addEventListener("input", filter);
})();
(function () {
  // Klikbare rijen (tr.click met data-href): klik opent, Enter opent, Ctrl/Cmd-klik of middelste muisknop opent in een nieuw tabblad.
  // Knoppen en links in de rij doen gewoon hun eigen ding.
  document.querySelectorAll("tr.click[data-href]").forEach(function (tr) {
    var url = tr.getAttribute("data-href"), nieuw = tr.getAttribute("data-target") === "_blank";
    tr.setAttribute("tabindex", "0"); tr.setAttribute("role", "link");
    function ga(e) { if (e.target.closest("a, button, form, input, select, label")) return; if (nieuw || e.ctrlKey || e.metaKey || e.button === 1) window.open(url, "_blank"); else location.href = url; }
    tr.addEventListener("click", ga);
    tr.addEventListener("auxclick", function (e) { if (e.button === 1) { e.preventDefault(); ga(e); } });
    tr.addEventListener("keydown", function (e) { if (e.key === "Enter" && e.target === tr) ga(e); });
  });
})();
(function () {
  // Menu op de telefoon: knop in de balk opent het volledige menu als paneel; sluit via kruisje, achtergrond, Escape of een keuze
  var nav = document.getElementById("sidenav"), knop = document.getElementById("menu-knop"), achter = document.getElementById("menu-achter"), sluit = document.getElementById("menu-sluit");
  if (!nav || !knop) return;
  function zet(open) { nav.classList.toggle("open", open); achter.hidden = !open; knop.setAttribute("aria-expanded", open ? "true" : "false"); document.body.classList.toggle("menu-open", open); if (open) { var on = nav.querySelector(".side-link.on"); if (on) on.scrollIntoView({ block: "nearest" }); } }
  knop.addEventListener("click", function () { zet(!nav.classList.contains("open")); });
  sluit.addEventListener("click", function () { zet(false); });
  achter.addEventListener("click", function () { zet(false); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && nav.classList.contains("open")) zet(false); });
  nav.addEventListener("click", function (e) { if (e.target.closest("a")) zet(false); });
})();
(function () {
  // Weergave: licht, donker of systeem. Keuze in localStorage; bij "systeem" volgt de app de instelling van het apparaat
  var knoppen = document.querySelectorAll("[data-thema-knop]");
  function pas(keuze) {
    var donker = keuze === "donker" || (keuze === "systeem" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.setAttribute("data-thema", donker ? "donker" : "licht"); var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute("content", donker ? "#071f56" : "#073889");
    knoppen.forEach(function (k) { k.classList.toggle("on", k.getAttribute("data-thema-knop") === keuze); });
  }
  var huidig = "systeem"; try { huidig = localStorage.getItem("wp_thema") || "systeem"; } catch (e) {}
  pas(huidig);
  knoppen.forEach(function (k) { k.addEventListener("click", function () { var v = k.getAttribute("data-thema-knop"); try { localStorage.setItem("wp_thema", v); } catch (e) {} pas(v); }); });
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () { var v = "systeem"; try { v = localStorage.getItem("wp_thema") || "systeem"; } catch (e) {} if (v === "systeem") pas(v); });
})();
(function () {
  // Zoeken terwijl je typt: vanaf twee tekens, resultaten onder het zoekveld; pijltjes en Enter, Escape sluit
  var veld = document.getElementById("topzoek"), lijst = document.getElementById("zoek-lijst");
  if (!veld || !lijst) return;
  var timer = null, keuze = -1, laatste = "";
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function sluit() { lijst.hidden = true; lijst.innerHTML = ""; keuze = -1; }
  function items() { return lijst.querySelectorAll("a.zoek-item"); }
  function markeer(i) { var all = items(); if (!all.length) return; keuze = (i + all.length) % all.length; all.forEach(function (a, n) { a.classList.toggle("on", n === keuze); }); all[keuze].scrollIntoView({ block: "nearest" }); }
  function toon(data, q) {
    if (!data.groepen.length) { lijst.innerHTML = '<div class="zoek-leeg">Niets gevonden voor "' + esc(q) + '"</div>'; lijst.hidden = false; return; }
    var html = "";
    data.groepen.forEach(function (g) {
      html += '<div class="zoek-kop">' + esc(g.titel) + "</div>";
      g.items.forEach(function (it) {
        html += '<a class="zoek-item" href="' + esc(it.url) + '">' + (it.plaat ? '<span class="plate">' + esc(it.plaat) + "</span>" : '<span class="msr">' + esc(it.icoon || "search") + "</span>") + '<span class="zoek-tekst"><strong>' + esc(it.titel) + "</strong>" + (it.sub ? '<span class="muted small"> · ' + esc(it.sub) + "</span>" : "") + "</span></a>";
      });
    });
    html += '<a class="zoek-item zoek-alles" href="' + esc(data.alles) + '"><span class="msr">list</span><span class="zoek-tekst">Alle resultaten in het wagenpark</span></a>';
    lijst.innerHTML = html; lijst.hidden = false; keuze = -1;
  }
  function zoek() {
    var q = veld.value.trim();
    if (q.length < 2) { sluit(); return; }
    if (q === laatste && !lijst.hidden) return;
    laatste = q;
    fetch("/zoeken.json?q=" + encodeURIComponent(q)).then(function (r) { return r.json(); }).then(function (d) { if (veld.value.trim() === q) toon(d, q); }).catch(function () {});
  }
  veld.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(zoek, 180); });
  veld.addEventListener("focus", function () { if (veld.value.trim().length >= 2) zoek(); });
  veld.addEventListener("keydown", function (e) {
    if (lijst.hidden) return;
    if (e.key === "ArrowDown") { e.preventDefault(); markeer(keuze + 1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); markeer(keuze - 1); }
    else if (e.key === "Enter" && keuze >= 0) { e.preventDefault(); location.href = items()[keuze].href; }
    else if (e.key === "Escape") { sluit(); }
  });
  document.addEventListener("click", function (e) { if (!veld.parentNode.contains(e.target)) sluit(); });
})();
(function () {
  // Versienummer: eenmalig het tekstballonnetje, tot je erop klikt
  try {
    var b = document.getElementById("versie-bubble"), l = document.getElementById("versie-link");
    if (b && l && !localStorage.getItem("wp_versie_gezien")) { b.hidden = false; l.addEventListener("click", function () { localStorage.setItem("wp_versie_gezien", "1"); }); }
  } catch (e) {}
  // Nieuwe versie: elke minuut kijken; bij rust (tabblad niet zichtbaar, of 5 minuten niets aangeraakt) vanzelf vernieuwen, anders een balkje
  var huidige = <%- JSON.stringify(typeof versie !== "undefined" ? versie.huidige : "") %>, laatst = Date.now(), nieuw = false;
  ["click", "keydown", "scroll", "touchstart"].forEach(function (ev) { document.addEventListener(ev, function () { laatst = Date.now(); }, { passive: true }); });
  function vernieuw() { if (document.hidden || Date.now() - laatst > 5 * 60000) { if (!document.querySelector("form input:focus, form textarea:focus")) location.reload(); } }
  function check() {
    fetch("/version.json", { cache: "no-store" }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
      if (!j || !huidige || j.versie === huidige) return;
      nieuw = true; document.getElementById("versie-nieuw").hidden = false; vernieuw();
    }).catch(function () {});
  }
  setInterval(check, 60000);
  document.addEventListener("visibilitychange", function () { if (nieuw) vernieuw(); else if (!document.hidden) check(); });
})();
</script>
