<%- include("../partials/header") %>
<div class="dash-page">
<div class="page-head">
  <div>
    <div class="eyebrow">Wagenpark</div>
    <h1><%= vestigingNaam || "Alle vestigingen" %></h1>
    <div class="sub"><%= new Date().toLocaleDateString("nl-NL", { weekday: "long", day: "numeric", month: "long" }) %> · <%= vandaag.length ? vandaag.length + (vandaag.length === 1 ? " ding" : " dingen") + " voor vandaag" : "niets voor vandaag" %></div>
  </div>
  <div class="actions">
    <form method="GET" class="filters" style="margin:0">
      <select name="vestiging" onchange="this.form.submit()">
        <option value="alle" <%= !vId ? "selected" : "" %>>Alle vestigingen</option>
        <% vestigingen.forEach(v => { %><option value="<%= v.id %>" <%= vId === v.id ? "selected" : "" %>><%= v.naam %></option><% }) %>
      </select>
    </form>
  </div>
</div>

<div class="tiles dash-tiles">
  <a class="tile" href="/voertuigen<%= vId ? "?vestiging=" + vId : "" %>">
    <div class="lbl">Wagenpark</div>
    <div class="row"><span class="big"><%= counts.actief + counts.uitgeleend %></span><span class="muted">rijden</span></div>
    <div class="muted small"><%= counts.op_voorraad %> op voorraad · <%= counts.besteld %> besteld<% if (!vId) { %><br><%= perVestiging.map(p => p.naam + " " + p.n).join(" · ") %><% } %></div>
  </a>
  <a class="tile" href="/voertuigen?sort=apk<%= vId ? "&vestiging=" + vId : "" %>">
    <div class="lbl">APK op orde</div>
    <div class="row"><span class="big <%= counts.apk_ok < counts.met_kenteken ? 'warn' : '' %>"><%= counts.apk_ok %></span><span class="muted">van <%= counts.met_kenteken %></span></div>
    <div class="muted small"><%= counts.apk_ok < counts.met_kenteken ? (counts.met_kenteken - counts.apk_ok) + " verlopen of onbekend" : "geldige APK, via de RDW" %></div>
  </a>
  <a class="tile" href="/taken<%= vId ? "?vestiging=" + vId : "" %>">
    <div class="lbl">Open taken</div>
    <div class="row"><span class="big <%= openTaken.te_laat > 0 ? 'warn' : '' %>"><%= openTaken.n %></span><span class="muted"><%= openTaken.n === 1 ? "taak" : "taken" %></span></div>
    <div class="muted small"><%= openTaken.te_laat > 0 ? openTaken.te_laat + " over de deadline" : openTaken.n ? "geen over de deadline" : "alles afgerond" %></div>
  </a>
  <a class="tile" href="/uitleen">
    <div class="lbl">Leenverzoeken</div>
    <div class="row"><span class="big"><%= leensnelheid.n ? leensnelheid.dagen : "–" %></span><span class="muted"><%= leensnelheid.n ? "dagen" : "" %></span></div>
    <div class="muted small"><%= leensnelheid.n ? "gemiddeld tot besluit, laatste 90 dagen" : "nog geen verzoeken beantwoord" %></div>
  </a>
</div>

<div class="grid-2 dash-grid">
  <div>
    <div class="card">
      <div class="card-head"><h2><span class="msr" style="color:var(--oranje)">flag</span> Vandaag voor jou</h2><span class="muted small"><%= vandaag.length %></span></div>
      <div class="rows dash">
        <% vandaag.forEach(r => { %>
          <div>
            <span class="dash-tekst"><span class="msr" style="color:var(--<%= r.kleur %>)"><%= r.icoon %></span><% if (r.plaat) { %> <span class="plate"><%= r.plaat %></span><% } %> <%= r.tekst %></span>
            <span class="v dash-knop"><% if (r.pill) { %><span class="pill <%= r.pill.klasse %>"><%= r.pill.tekst %></span><% } %><a href="<%= r.knop.url %>" class="btn small <%= r.kleur === 'rood' ? 'primary' : '' %>"><%= r.knop.tekst %></a></span>
          </div>
        <% }) %>
        <% if (!vandaag.length) { %><div class="empty"><span class="msr" style="color:var(--groen);font-size:28px">check_circle</span><br>Niets dat vandaag aandacht vraagt.</div><% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><span class="msr" style="color:var(--blauw)">upcoming</span> Komende weken</h2><a href="/taken" class="small">Alle taken →</a></div>
      <div class="rows dash">
        <% komend.forEach(r => { %>
          <div>
            <span class="dash-tekst"><span class="msr" style="color:var(--grijs)"><%= r.icoon %></span><% if (r.plaat) { %> <span class="plate"><%= r.plaat %></span><% } %> <a href="<%= r.url %>" style="color:inherit"><%= r.tekst %></a></span>
            <span class="v muted small nowrap"><%= r.wanneer %></span>
          </div>
        <% }) %>
        <% if (besteld.length) { %>
          <div>
            <span class="dash-tekst"><span class="msr" style="color:var(--grijs)">local_shipping</span> <%= besteld.length %> auto's besteld<% const groepen = {}; besteld.forEach(b => { const k = `${b.merk} ${b.model || ""}`.trim() + (b.verwachte_levering ? ` (${b.verwachte_levering})` : ""); groepen[k] = (groepen[k] || 0) + 1; }); const lijst = Object.entries(groepen).map(([k, n]) => (n > 1 ? `${n}× ` : "") + k); %>: <%= lijst.slice(0, 4).join(", ") %><%= lijst.length > 4 ? ", ..." : "" %></span>
            <span class="v"><a href="/voertuigen?status=besteld" class="small">bekijken</a></span>
          </div>
        <% } %>
        <% if (!komend.length && !besteld.length) { %><div class="muted">Niets gepland de komende weken.</div><% } %>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card-head"><h2><span class="msr" style="color:var(--oranje)">bolt</span> Snel</h2></div>
      <div class="dash-snel">
        <% if (can("beheerder")) { %>
          <a href="/uitleen/toewijzen" class="btn"><span class="msr">person_add</span>Toewijzen</a>
          <a href="/uitleen/toewijzen?soort=uitleen" class="btn"><span class="msr">key</span>Uitlenen</a>
          <a href="/boetes/nieuw" class="btn"><span class="msr">receipt_long</span>Boete</a>
          <a href="/incidenten/nieuw" class="btn"><span class="msr">car_crash</span>Incident</a>
          <a href="/voertuigen/nieuw" class="btn primary"><span class="msr">add</span>Nieuw voertuig</a>
        <% } else { %>
          <a href="/uitleen/aanvragen" class="btn"><span class="msr">key</span>Leenverzoek</a>
          <a href="/export" class="btn"><span class="msr">download</span>Export</a>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><span class="msr" style="color:var(--groen)">eco</span> Verduurzaming</h2><a href="/export" class="small">Export →</a></div>
      <% const tot = milieu.reduce((s, m) => s + m.n, 0) || 1; const kleur = { elektrisch: "var(--groen)", hybride: "var(--blauw-soft)", benzine: "var(--oranje)", diesel: "var(--grijs)", onbekend: "var(--grijs-thin)" }; %>
      <div class="milieu-balk"><% milieu.forEach(m => { %><span style="width:<%= m.n * 100 / tot %>%;background:<%= kleur[m.milieu] || kleur.onbekend %>" title="<%= h.label("milieu", m.milieu) || m.milieu %> <%= m.n %>"></span><% }) %></div>
      <div class="milieu-legenda">
        <% milieu.forEach(m => { %><span><i style="background:<%= kleur[m.milieu] || kleur.onbekend %>"></i><%= h.label("milieu", m.milieu) || m.milieu %> <strong><%= Math.round(m.n * 100 / tot) %>%</strong> <span class="muted">(<%= m.n %>)</span></span><% }) %>
      </div>
      <div class="muted small" style="margin-top:10px"><%= counts.doc_ok %> van <%= counts.met_kenteken %> auto's hebben een kentekenbewijs in de app.</div>
    </div>
  </div>
</div>
</div>
<%- include("../partials/footer") %>
