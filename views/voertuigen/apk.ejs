<%- include("../partials/header") %>
<div class="muted small" style="margin-bottom:10px"><a href="<%= mijn ? "/mijn-auto" : "/voertuigen/" + v.id %>"><%= mijn ? "Mijn auto" : (v.kenteken || v.merk) %></a> › APK</div>
<%
  // Twee stappen voor de bestuurder op de telefoon: eerst de garage bereiken (bellen, website, route), dan de datum in de app zetten.
  const d = h.daysUntil(v.apk_vervaldatum);
  const tel = garage && garage.telefoon ? garage.telefoon.replace(/\s/g, "") : null;
  const site = garage && garage.website ? (garage.website.startsWith("http") ? garage.website : "https://" + garage.website) : null;
  const route = garage && garage.adres ? "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(garage.naam + ", " + garage.adres) : null;
  const geweest = v.apk_afspraak && h.daysUntil(v.apk_afspraak) < 0;
%>
<div style="max-width:560px">
  <div class="page-head" style="margin-bottom:14px">
    <div><div class="eyebrow">APK</div><h1><span class="plate big"><%= v.kenteken || "besteld" %></span> <%= v.merk %> <%= v.model || "" %></h1>
      <div class="sub"><% if (v.apk_vervaldatum) { %><span class="pill <%= d < 0 ? 'bad' : d < 30 ? 'warn' : 'ok' %>">APK <%= d < 0 ? "verstreken" : "vervalt" %> <%= h.formatDate(v.apk_vervaldatum) %></span> <span class="muted"><%= h.relativeDate(v.apk_vervaldatum) %></span><% } else { %>datum onbekend<% } %></div>
    </div>
  </div>

  <% if (v.apk_afspraak) { %>
  <div class="card" style="border-left:5px solid var(--<%= geweest ? 'oranje' : 'groen' %>)">
    <div class="lbl"><span class="msr"><%= geweest ? "upload_file" : "event_available" %></span>Afspraak staat op <%= h.formatDate(v.apk_afspraak) %></div>
    <% if (geweest) { %><p style="margin:8px 0 10px">De keuring is geweest. Upload het keuringsrapport, dan zet de beheerder de nieuwe APK-datum.</p><a href="/voertuigen/<%= v.id %>/documenten?soort=apk_rapport" class="btn primary"><span class="msr">upload_file</span>Rapport uploaden</a>
    <% } else { %><p class="muted small" style="margin:6px 0 0">Na de keuring vraagt de app om het rapport. Andere datum? Zet hem hieronder opnieuw.</p><% } %>
  </div>
  <% } %>

  <div class="card">
    <div class="lbl"><span class="msr">garage</span>Stap 1 · Maak de afspraak bij de garage</div>
    <% if (garage) { %>
      <h3 style="margin-top:8px"><%= garage.naam %></h3>
      <% if (garage.adres) { %><p class="muted" style="margin:2px 0 0"><%= garage.adres %></p><% } %>
      <div class="apk-knoppen">
        <% if (tel) { %><a href="tel:<%= tel %>" class="btn primary"><span class="msr">call</span>Bellen<span class="apk-sub"><%= garage.telefoon %></span></a><% } %>
        <% if (site) { %><a href="<%= site %>" target="_blank" rel="noopener" class="btn"><span class="msr">language</span>Website<span class="apk-sub">afspraak online</span></a><% } %>
        <% if (route) { %><a href="<%= route %>" target="_blank" rel="noopener" class="btn"><span class="msr">navigation</span>Route<span class="apk-sub">navigatie openen</span></a><% } %>
      </div>
      <% if (!tel && !site && !route) { %><p class="muted small" style="margin-top:8px">Geen telefoonnummer, website of adres bekend. Bel wagenparkbeheer.</p><% } %>
      <% if (garage.opmerking) { %><p class="muted small" style="margin:10px 0 0"><%= garage.opmerking %></p><% } %>
    <% } else { %><p class="muted" style="margin-top:8px">Geen garage voor <%= v.merk %> in de contacten. Bel wagenparkbeheer, die weet waar deze auto gekeurd wordt.</p><% } %>
  </div>

  <div class="card">
    <div class="lbl"><span class="msr">event</span>Stap 2 · Zet de datum in de app</div>
    <form method="POST" action="/voertuigen/<%= v.id %>/apk" class="form" style="grid-template-columns:1fr;margin-top:8px">
      <label>Datum van de afspraak<input type="date" name="apk_afspraak" value="<%= v.apk_afspraak || "" %>" required></label>
      <div class="buttons" style="justify-content:flex-start"><button type="submit" class="btn primary"><span class="msr">event_available</span>Vastleggen</button><% if (v.apk_afspraak && can("beheerder")) { %><button type="submit" name="wissen" value="1" class="btn ghost">Afspraak wissen</button><% } %></div>
    </form>
    <p class="muted small" style="margin:10px 0 0">Na die dag vraagt de app om het keuringsrapport. Een beheerder keurt het goed en zet de nieuwe APK-datum.</p>
  </div>
</div>
<%- include("../partials/footer") %>
