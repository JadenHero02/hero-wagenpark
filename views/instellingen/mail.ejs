<%- include("../partials/header") %>
<div class="muted small" style="margin-bottom:10px"><a href="/instellingen">Instellingen</a> › Maillog</div>
<div class="page-head"><div><div class="eyebrow">Admin</div><h1>Maillog</h1><div class="sub"><% if (mailMode === "verstuurd") { %>Verstuurd via Microsoft 365 vanaf <%= mailFrom %>.<% } else { %>Microsoft 365 is nog niet ingesteld: deze mails zijn alleen gelogd, niet verstuurd. Klik op een regel om de mail te zien.<% } %><% if (mailTest) { %> Testmodus: alles naar <%= mailTest %>.<% } %></div></div></div>
<div class="card" style="padding:0">
  <table class="list">
    <thead><tr><th>Wanneer</th><th>Naar</th><th>Onderwerp</th><th>Soort</th><th>Status</th></tr></thead>
    <tbody>
    <% rows.forEach(m => { %>
      <tr class="click" data-href="/instellingen/mail/<%= m.id %>" data-target="_blank">
        <td class="small nowrap"><%= h.formatDate(m.verstuurd_op, true) %></td>
        <td class="small"><%= m.naar %><% if (m.cc) { %><div class="muted">cc <%= m.cc %></div><% } %></td>
        <td><%= m.onderwerp %></td>
        <td class="small muted"><%= m.soort || "" %></td>
        <td><span class="pill <%= m.status === 'verstuurd' ? 'ok' : m.status === 'fout' ? 'soft' : 'grey' %>"><%= m.status %></span><% if (m.fout) { %><div class="muted small"><%= m.fout %></div><% } %></td>
      </tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="5" class="empty">Nog geen mail.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include("../partials/footer") %>
