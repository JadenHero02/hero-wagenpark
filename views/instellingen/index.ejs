<%- include("../partials/header") %>
<div class="page-head">
  <div><div class="eyebrow">Admin</div><h1>Instellingen</h1><div class="sub">Termijnen en adressen. Rollen staan op een eigen pagina. Alleen voor de admin.</div></div>
  <div class="actions"><a href="/instellingen/mail" class="btn"><span class="msr">mail</span>Maillog (<%= mails.n %><%= mails.fout ? ", " + mails.fout + " mislukt" : "" %>)</a></div>
</div>
<div class="grid-2">
  <div class="card">
    <div class="card-head"><h2>Termijnen en adressen</h2></div>
    <form method="POST" action="/instellingen" class="form">
      <% VELDEN.forEach(([key, label, hint]) => { %>
        <label class="<%= key.endsWith("_emails") || key === "hr_email" ? "full" : "" %>"><%= label %><% if (hint) { %> <span class="hint"><%= hint %></span><% } %><input name="<%= key %>" value="<%= waarden[key] || "" %>"></label>
      <% }) %>
      <div class="buttons"><button type="submit" class="btn primary"><span class="msr">save</span>Opslaan</button></div>
    </form>
  </div>
  <div>
    <div class="card">
      <div class="card-head"><h2>Mail</h2></div>
      <dl class="kv">
        <dt>Stand</dt><dd><% if (mailMode === "verstuurd") { %><span class="pill ok">verstuurt via Microsoft 365</span><% } else { %><span class="pill warn">alleen loggen</span> <span class="muted small">MS_TENANT_ID, MS_CLIENT_ID en MS_CLIENT_SECRET nog niet ingesteld; mails staan in het maillog</span><% } %></dd>
        <dt>Afzender</dt><dd><%= mailFrom %></dd>
        <% if (mailTest) { %><dt>Testmodus</dt><dd>Alles gaat naar <%= mailTest %></dd><% } %>
      </dl>
    </div>
    <div class="card">
      <div class="card-head"><h2>Gebruikers en rollen</h2><a href="/instellingen/rollen" class="btn small"><span class="msr">manage_accounts</span>Naar Rollen</a></div>
      <p class="muted">Wie admin, directie, beheerder of bestuurder is, wie al is ingelogd en wie welke rol krijgt bij de eerste login: dat staat alleen onder Rollen.</p>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>
