<%- include("../partials/header") %>
<div class="muted small" style="margin-bottom:10px"><a href="/instellingen">Instellingen</a> › Rollen</div>
<div class="page-head">
  <div><div class="eyebrow">Admin</div><h1>Rollen</h1><div class="sub">Wie heeft welke rol · <%= totaal %> mensen · <%= groepen.map(g => g.rijen.length + " " + g.label.toLowerCase()).join(" · ") %></div></div>
</div>

<% const OK = '<span class="msr" style="color:var(--groen);font-size:20px">check</span>', NEE = '<span class="muted">–</span>', EIGEN = (t) => `<span class="small" style="color:var(--blauw-bold)">${t}</span>`;
   const MATRIX = [
     ["Zien", null],
     ["Wagenpark, bestuurders, contacten, archief", OK, OK, OK, EIGEN("alleen eigen auto")],
     ["Dashboard, taken, uitleen, processen", OK, OK, OK, NEE],
     ["Incidenten", OK, OK, OK, EIGEN("alleen eigen")],
     ["Boetes", OK, OK, EIGEN("celdirecteuren en HR"), EIGEN("alleen eigen")],
     ["Pincode tankpas, na extra bevestiging", OK, NEE, OK, EIGEN("alleen eigen auto")],
     ["Exporteren naar Excel", OK, OK, OK, NEE],
     ["Doen", null],
     ["Km-stand, APK-afspraak, rapport uploaden, incident melden, leenauto aanvragen", OK, EIGEN("leenauto aanvragen"), OK, EIGEN("eigen auto")],
     ["Auto's invoeren, toewijzen, innemen, checklists", OK, NEE, OK, NEE],
     ["APK-rapporten goedkeuren", OK, NEE, OK, NEE],
     ["Leenverzoeken goedkeuren", OK, NEE, EIGEN("alleen celdirecteur"), NEE],
     ["Boetes invoeren en doorbelasten (HR)", OK, NEE, NEE, NEE],
     ["Taken, documenten, contacten, wachtlijst beheren", OK, NEE, OK, NEE],
     ["Naar het archief zetten", OK, NEE, EIGEN("via uitstroom"), NEE],
     ["Beheren", null],
     ["Rollen toekennen, accounts uitzetten", OK, NEE, NEE, NEE],
     ["Instellingen: termijnen, HR-adres, maillog, RDW bijwerken", OK, NEE, NEE, NEE],
     ["Contacten verwijderen, auto uit het archief halen", OK, NEE, NEE, NEE],
   ]; %>
<details class="card" style="margin-bottom:16px;padding:0" <%= totaal <= 3 ? "open" : "" %>>
  <summary style="list-style:none;cursor:pointer;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;gap:10px"><h2><span class="msr" style="color:var(--oranje)">shield_person</span> Wat mag welke rol</h2><span class="muted small">klik om te <span class="matrix-open">openen</span><span class="matrix-dicht">sluiten</span> · rechten worden op de server afgedwongen</span></summary>
  <table class="list matrix">
    <thead><tr><th></th><th><span class="pill rol-admin">Admin</span><div class="muted" style="font-weight:400;text-transform:none;letter-spacing:0"><%= groepen[0].rijen.length ? groepen[0].rijen.map(r => r.naam.split(" ")[0]).join(", ") : "niemand" %></div></th><th><span class="pill rol-directie">Directie</span><div class="muted" style="font-weight:400;text-transform:none;letter-spacing:0"><%= groepen[1].rijen.length %> personen</div></th><th><span class="pill rol-beheerder">Beheerder</span><div class="muted" style="font-weight:400;text-transform:none;letter-spacing:0">celdirecteuren</div></th><th><span class="pill rol-bestuurder">Bestuurder</span><div class="muted" style="font-weight:400;text-transform:none;letter-spacing:0">iedereen met een auto</div></th></tr></thead>
    <tbody>
    <% MATRIX.forEach(r => { if (r[1] === null) { %><tr class="groep"><td colspan="5"><%= r[0] %></td></tr><% } else { %><tr><td><%= r[0] %></td><td><%- r[1] %></td><td><%- r[2] %></td><td><%- r[3] %></td><td><%- r[4] %></td></tr><% } }) %>
    </tbody>
  </table>
  <div class="muted small" style="padding:8px 18px 14px"><span class="msr" style="color:var(--groen);font-size:16px">check</span> mag · <span style="color:var(--blauw-bold)">blauw</span> beperkt tot de eigen auto · – mag niet. Een hogere rol mag alles wat een lagere mag.</div>
</details>

<div class="card" style="margin-bottom:16px">
  <div class="lbl"><span class="msr">person_add</span>Rol toekennen</div>
  <form method="POST" action="/instellingen/rollen" class="actions" style="margin-top:10px">
    <input name="email" type="email" required placeholder="naam@hero.eu" style="padding:8px 10px;border:1px solid var(--grijs-thin);border-radius:8px;font:inherit;min-width:240px">
    <select name="rol" style="padding:8px 10px;border:1px solid var(--grijs-thin);border-radius:8px;font:inherit"><% ["admin","directie","beheerder","bestuurder"].forEach(r => { %><option value="<%= r %>" <%= r === "beheerder" ? "selected" : "" %>><%= LABELS.role[r] %></option><% }) %></select>
    <select name="vestiging_id" style="padding:8px 10px;border:1px solid var(--grijs-thin);border-radius:8px;font:inherit"><option value="">vestiging (voor mails)</option><% vestigingen.forEach(ve => { %><option value="<%= ve.id %>"><%= ve.naam %></option><% }) %></select>
    <button class="btn primary" type="submit">Toekennen</button>
    <span class="muted small">Geldt direct als de persoon al is ingelogd, anders bij de eerste login.</span>
  </form>
</div>

<% const beschrijving = { admin: "Alles, plus instellingen, rollen, maillog en de Excel-import.", directie: "Ziet alles, exporteert, wijzigt niets.", beheerder: "Auto's, toewijzen en innemen, checklists, taken, leenverzoeken en rapporten goedkeuren, boetes bevestigen, documenten.", bestuurder: "Alleen de eigen auto in Mijn auto." }; %>
<% groepen.forEach(g => { %>
<div class="card" style="padding:0;margin-bottom:16px">
  <div style="padding:14px 18px 6px;display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap"><h2><span class="pill rol-<%= g.rol %>" style="font-size:12px;margin-right:8px"><%= g.label %></span><%= g.rijen.length %></h2><span class="muted small"><%= beschrijving[g.rol] %></span></div>
  <table class="list">
    <thead><tr><th>Naam</th><th>Functie</th><th>Vestiging</th><th>Auto</th><th>Ingelogd</th><th></th></tr></thead>
    <tbody>
    <% g.rijen.forEach(r => { %>
      <tr>
        <td><strong><%= r.naam %></strong><div class="muted small"><%= r.email %><%= r.telefoon ? " · " + r.telefoon : "" %></div></td>
        <td class="small"><% if (r.functie.length) { %><%= r.functie.map(f => f.charAt(0).toUpperCase() + f.slice(1)).join(", ") %><% } %><% if (r.jobTitle) { %><div class="muted"><%= r.jobTitle %></div><% } %></td>
        <td><%= r.vestiging || "" %></td>
        <td><% if (r.auto) { %><span class="plate"><%= r.auto.replace(" (leen)", "") %></span><%= r.auto.includes("(leen)") ? ' <span class="muted small">leen</span>' : "" %><% } %></td>
        <td class="small"><% if (r.ingelogd) { %><span class="pill ok">ja</span> <span class="muted"><%= h.formatDate(r.ingelogd) %></span><% } else { %><span class="muted">nog niet</span><% } %><% if (!r.actief) { %> <span class="pill soft">uitgezet</span><% } %></td>
        <td class="nowrap">
          <form method="POST" action="/instellingen/rollen" class="inline">
            <input type="hidden" name="email" value="<%= r.email %>">
            <select name="rol" data-naam="<%= r.naam %>" data-was="<%= r.rol %>" onchange="rolWijzigen(this)" title="Rol wijzigen" style="padding:5px;border:1px solid var(--grijs-thin);border-radius:8px;font:inherit;font-size:12px"><% ["admin","directie","beheerder","bestuurder"].forEach(x => { %><option value="<%= x %>" <%= r.rol === x ? "selected" : "" %>><%= LABELS.role[x] %></option><% }) %></select>
          </form>
          <% if (r.user_id && r.user_id !== currentUser.id) { %><form method="POST" action="/instellingen/rollen/uitzetten" class="inline"><input type="hidden" name="user_id" value="<%= r.user_id %>"><input type="hidden" name="aan" value="<%= r.actief ? "0" : "1" %>"><button class="btn small ghost" type="submit" title="<%= r.actief ? "Toegang tot de app uitzetten; de persoon blijft in de lijst" : "Toegang weer aanzetten" %>"><span class="msr"><%= r.actief ? "block" : "check" %></span><%= r.actief ? "Uitzetten" : "Aanzetten" %></button></form><% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!g.rijen.length) { %><tr><td colspan="6" class="empty">Niemand.</td></tr><% } %>
    </tbody>
  </table>
</div>
<% }) %>
<p class="muted small">Functie komt uit Contacten (celdirecteur, wagenparkbeheer) en de medewerkerslijst. Rol is wat iemand in de app mag. Wie nog niet is ingelogd krijgt de rol hier bij de eerste login; wie nergens staat wordt bestuurder. Dit is de enige plek waar rollen staan.</p>
<script>
  // Rol wijzigen: eerst bevestigen, anders terug naar wat het was
  function rolWijzigen(s) {
    var naar = s.options[s.selectedIndex].text;
    var tekst = "Rol van " + s.dataset.naam + " wijzigen naar " + naar + "?" + (s.value === "admin" ? "\n\nAdmin mag alles, ook rollen toekennen en instellingen wijzigen." : "");
    if (confirm(tekst)) s.form.submit(); else s.value = s.dataset.was;
  }
</script>
<%- include("../partials/footer") %>
