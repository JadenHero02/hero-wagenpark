<%- include("partials/header") %>
<div class="page-head"><div><div class="eyebrow">Mijn auto</div><h1><%= currentUser.name %></h1></div></div>
<% if (!autos.length) { %>
  <div class="card"><div class="empty">Er staat geen auto op jouw naam. Klopt dat niet? Bel wagenparkbeheer.</div></div>
<% } %>
<% autos.forEach(v => { const dagen = h.daysUntil(v.apk_vervaldatum); const garage = garages.find(g => g.merk && v.merk && g.merk.toLowerCase().includes(v.merk.toLowerCase().split(" ")[0])) || garages.find(g => (g.merk || "").toLowerCase() === "alle"); %>
  <div class="card" style="max-width:520px">
    <div class="vehicle-head">
      <span class="plate big"><%= v.kenteken || "besteld" %></span>
      <div><h2><%= v.merk %> <%= v.model || "" %></h2><div class="meta"><span><%= v.vestiging || "" %></span><span><%= v.toewijzing_soort === "uitleen" ? "leenauto" : "sinds " + h.formatDate(v.van) %></span></div></div>
    </div>
    <% if (dagen !== null && dagen < 30) { %>
      <div class="card" style="border-left:5px solid <%= dagen < 0 ? 'var(--rood)' : 'var(--oranje)' %>;margin-top:14px">
        <div class="lbl" style="color:<%= dagen < 0 ? 'var(--rood)' : 'var(--oranje)' %>"><span class="msr">error</span>Actie nodig</div>
        <p><strong>APK <%= dagen < 0 ? "is verstreken" : "vervalt " + h.relativeDate(v.apk_vervaldatum) %>.</strong> Plan zelf een afspraak.</p>
        <% if (garage) { %><p class="muted small"><%= garage.naam %><%= garage.telefoon ? " · " + garage.telefoon : "" %></p><% } %>
      </div>
    <% } %>
    <div class="grid-3" style="margin-top:14px;grid-template-columns:1fr 1fr">
      <div class="card"><div class="lbl">Km-stand</div><div class="tile-big" style="font-size:22px;font-weight:800;color:var(--blauw)"><%= v.km_stand ? h.num(v.km_stand) : "onbekend" %></div><div class="muted small"><%= v.km_datum ? h.formatDate(v.km_datum) : "nog niet doorgegeven" %></div>
        <form method="POST" action="/voertuigen/<%= v.id %>/kilometerstand" class="actions" style="margin-top:8px"><input type="number" name="stand" min="0" placeholder="Nieuwe stand" required style="width:120px;padding:8px;border:1px solid var(--grijs-thin);border-radius:8px;font:inherit"><button class="btn small" type="submit"><span class="msr">speed</span>Doorgeven</button></form>
      </div>
      <div class="card"><div class="lbl">Tankpas</div><div style="font-weight:700"><%= v.tankpas_nummer || "geen" %></div>
        <% if (v.tankpas_pincode_enc) { %><form method="POST" action="/voertuigen/<%= v.id %>/pincode" style="margin-top:8px"><button class="btn small" type="submit"><span class="msr">visibility</span>Pincode</button></form><% } %>
      </div>
    </div>
    <% if (v.toewijzing_soort === "uitleen" && v.tot) { %><p class="muted small" style="margin-top:12px">Inleveren op <%= h.formatDate(v.tot) %>.</p><% } %>
  </div>
<% }) %>
<%- include("partials/footer") %>
